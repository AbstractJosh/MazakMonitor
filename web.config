<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!--
      ALP standart deploy: IIS, FastAPI'yi tek process olarak HttpPlatformHandler
      ile baslatir. Frontend (frontend/dist) FastAPI tarafindan servis edilir.

      DEPLOY ONCESI SUNUCUDA AYARLA:
      - processPath: sunucudaki uv (ya da python) tam yolu
      - arguments: uvicorn baslatma; --port %HTTP_PLATFORM_PORT% IIS'in atadigi port
      - stdoutLogFile: log yolu (klasor yazilabilir olmali)
      - DATABASE_URL: gercek deger (environmentVariables ya da .env)
      - Frontend once 'npm run build' ile frontend/dist uretilmis olmali
    -->
    <handlers>
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <httpPlatform
        processPath="C:\Program Files\uv\uv.exe"
        arguments="run --directory backend uvicorn app.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
        stdoutLogEnabled="true"
        stdoutLogFile=".\logs\stdout"
        startupTimeLimit="60"
        requestTimeout="00:04:00">
      <environmentVariables>
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <!-- DATABASE_URL burada ya da backend/.env icinde -->
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>