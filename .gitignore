node_modules/
.venv/

# --- Python uretilen ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Frontend uretilen ---
dist/
.vite/
*.tsbuildinfo

# --- Calisma zamani verisi ---
