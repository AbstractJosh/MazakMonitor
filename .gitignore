.env
.env.local
.claude/settings.local.json

# --- Isletim sistemi / editor ---
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/

# --- Aktarim artiklari (bu depoya bir daha girmez) ---
*.zip
