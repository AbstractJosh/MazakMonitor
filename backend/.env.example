# Bu dosyayi .env olarak kopyala ve gercek degerlerle doldur.
# .env asla commit edilmez (.gitignore'da).
#
# DATABASE_URL bir PostgreSQL baglanti dizesidir. Sema:
#   postgresql+psycopg dialect, ardindan kullanici, parola, sunucu, port, veritabani.
# Degerleri kendi ortamina gore gir. Ornek bir sablon olusturmak icin
# asagidaki parcalari birlestir (parolayi kendin ekle):
#   dialect = postgresql+psycopg
#   kullanici = postgres
#   sunucu = localhost
#   port = 5432
#   veritabani = alp
DATABASE_URL=